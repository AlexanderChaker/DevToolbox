@using CommunityToolkit.Maui.Storage;
@using DevToolbox.Services.Interfaces;
@using Models;
@using Services;

@namespace DevToolbox.Components.DeployGitBranch

@inject ILogger<SQLManager> Logger;
@inject ISQLService sqlService;
@inject ISnackbar Snackbar;

<MudStack Spacing="2">
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
        <MudTextField @bind-Value="serverUrl" FullWidth="true" Variant="Variant.Outlined" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SetServerURL">Set Server</MudButton>
    </MudStack>

    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
        <MudSelect T="string" Label="Default DB (optional)" @bind-Value="dbName" Variant="Variant.Outlined" Style="min-width: 240px;">
            @foreach (var db in dbNames)
            {
                <MudSelectItem T="string" Value="@db">@db</MudSelectItem>
            }
        </MudSelect>
    </MudStack>
</MudStack>

@code {
    [Parameter]
    public DeploymentOptions DeploymentOptions { get; set; } = new();

    [Parameter]
    public EventCallback<DeploymentOptions> DeploymentOptionsChanged { get; set; }

    protected string dbName { get; set; } = "";
    protected List<string> dbNames { get; set; } = new();
    protected string serverUrl { get; set; } = "";

    protected override async Task OnInitializedAsync()
    {
        serverUrl = await SecureStorage.Default.GetAsync("serverUrl")??"";
    }

    private async Task SetServerURL()
    {
        //TODO check if the connection is valid
        string connectionString = $"Server={serverUrl};Integrated Security=true;Multisubnetfailover=True;Application Name=DevToolkit.DevToolbox;Encrypt=true;TrustServerCertificate=True";
        sqlService.SetConnectionString(connectionString);

        try
        {
            dbNames = await sqlService.GetDBListAsync();
        }
        catch (Exception)
        {
            Snackbar.Add("Failed To Set Server", Severity.Error);
            return;
        }

        DeploymentOptions.ServerUrl = serverUrl;
        DeploymentOptions.DBAuthenticationUser = sqlService.GetCurrentUser();
        await SecureStorage.Default.SetAsync("serverUrl", serverUrl);
        await DeploymentOptionsChanged.InvokeAsync(DeploymentOptions);

        Snackbar.Add("Server Set Successfully", Severity.Success);
    }

}
