@using DevToolbox.Services.Interfaces;
@using DevToolbox.Services;
@using Models;

@namespace DevToolbox.Components.DeployGitBranch

@inject ILogger<DeploymentManager> Logger;
@inject InMemoryLoggerService inMemoryLoggerService;
@inject ISQLService sqlService;
@inject ISnackbar Snackbar;

<MudStack Spacing="2" Style="width: 100%;">
    <MudTextField Value="@DeploymentOptions.ServerUrl" ReadOnly="true" Label="Deploying on Server" Variant="Variant.Outlined" FullWidth="true" />
    <MudTextField Value="@DeploymentOptions.DBAuthenticationUser" ReadOnly="true" Label="Running as User" Variant="Variant.Outlined" FullWidth="true" />
    <MudTextField Value="@DeploymentOptions.WorkingDirectory" ReadOnly="true" Label="Working Directory" Variant="Variant.Outlined" FullWidth="true" />

    <MudText Typo="Typo.subtitle1">File List</MudText>
    <MudPaper Outlined="true" Class="pa-2" Style="max-height: 300px; overflow-y: auto;">
        <MudTable Items="@(DeploymentOptions.FileList ?? new List<string>())" Dense="true" Hover="true" Elevation="0">
            <HeaderContent>
                <MudTh>Path</MudTh>
                <MudTh Style="width: 64px;"/>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Path">@context</MudTd>
                <MudTd DataLabel="Action">
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => RemoveFile(context))" />
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>

    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
        <MudBadge Content="@(DeploymentOptions.FileList?.Count ?? 0)" Color="Color.Primary">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="RunSQLQueries" Disabled="@(DeploymentOptions.FileList is null || DeploymentOptions.FileList.Count == 0)">Run SQL</MudButton>
        </MudBadge>
    </MudStack>
</MudStack>

@code {
    [Parameter]
    public DeploymentOptions DeploymentOptions { get; set; } = new();

    [Parameter]
    public EventCallback<DeploymentOptions> DeploymentOptionsChanged { get; set; }

    private decimal processedQueries = 0;
    private decimal totalQueries = 0;

    private void RemoveFile(string file)
    {
        if (DeploymentOptions.FileList is null)
        {
            return;
        }

        DeploymentOptions.FileList.Remove(file);
    }

    private async Task RunSQLQueries()
    {
        inMemoryLoggerService.ClearLogs();
        processedQueries = 0;
        totalQueries = DeploymentOptions.FileList?.Count ?? 0;

        if (DeploymentOptions.FileList is null || DeploymentOptions.FileList.Count == 0)
        {
            Snackbar.Add("Generate Diffs first", Severity.Warning);
            return;
        }

        if (string.IsNullOrWhiteSpace(DeploymentOptions.ServerUrl))
        {
            Snackbar.Add("Set Server URL first", Severity.Warning);
            return;
        }

        Logger.LogInformation("===========Query Results===========");
        inMemoryLoggerService.Log("===========Query Results===========");

        try
        {
            foreach (string file in DeploymentOptions.FileList)
            {
                Uri uri = new(file);
                Uri baseUri = new("C:\\");
                inMemoryLoggerService.Log($"--Deploying to {DeploymentOptions.ServerUrl} file {baseUri.MakeRelativeUri(uri)}");
                var results = await sqlService.RunSQLQueryAsync(DeploymentOptions.ServerUrl, file);

                processedQueries++;

                foreach (string result in results)
                {
                    Logger.LogInformation(result);
                    inMemoryLoggerService.Log(result);
                    inMemoryLoggerService.Log($"[{DateTime.Now}] {result}");

                    await DeploymentOptionsChanged.InvokeAsync(DeploymentOptions);
                }
            }

            Snackbar.Add($"SQL Queries Deployed Successfully ({processedQueries}/{totalQueries})", Severity.Success);
        }
        catch (Exception)
        {
            Snackbar.Add("Could not run all SQL queries", Severity.Error);
        }
    }
}
