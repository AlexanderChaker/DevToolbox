@using CommunityToolkit.Maui.Storage;
@using Models;
@using Services;
@using DevToolbox.Services.Interfaces;

@namespace DevToolbox.Components.DeployGitBranch

@inject ILogger<GitManager> Logger;
@inject IGitService gitService;
@inject ISnackbar Snackbar;

<MudStack Spacing="2">
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
        <MudTextField Value="@DeploymentOptions.WorkingDirectory" ReadOnly="true" FullWidth="true" Variant="Variant.Outlined" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SetWorkingDirectoryAsync">Set Working Directory</MudButton>
    </MudStack>

    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
        <MudSelect T="string" Label="Current Branch" @bind-Value="currentBranch" Variant="Variant.Outlined" Style="min-width: 240px;">
            @foreach (var branch in gitBranches)
            {
                <MudSelectItem T="string" Value="@branch">@branch</MudSelectItem>
            }
        </MudSelect>
        <MudSwitch T="bool" @bind-Value="useYaml" Color="Color.Primary">Load Yaml</MudSwitch>
    </MudStack>

    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
        <MudSelect T="string" Label="Source Branch" @bind-Value="sourceBranch" Variant="Variant.Outlined" Style="min-width: 240px;">
            @foreach (var branch in gitBranches)
            {
                <MudSelectItem T="string" Value="@branch">@branch</MudSelectItem>
            }
        </MudSelect>
    </MudStack>

    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="RunGitDiffsAsync">Git Diffs</MudButton>
</MudStack>

@code {

    [Parameter]
    public DeploymentOptions DeploymentOptions { get; set; } = new();

    [Parameter]
    public EventCallback<DeploymentOptions> DeploymentOptionsChanged { get; set; }

    protected bool useYaml { get; set; } = false;
    protected string yamlFilePath { get; set; } = "";
    protected List<string>? yamlFoldersToProcess { get; set; }
    //protected string workingDirectory { get; set; } = "";
    protected string currentBranch { get; set; } = "dev";
    protected string sourceBranch { get; set; } = "master";
    protected List<string> gitBranches { get; set; } = new();

    private async Task LoadFileAsync()
    {
        Logger.LogInformation("Button Pressed");

        try
        {
            var result = await FilePicker.Default.PickAsync(PickOptions.Default);

            if (result != null)
            {
                Logger.LogInformation("File location: {path}", result.FullPath);
                yamlFilePath = result.FullPath;

                if (useYaml)
                {
                    Logger.LogInformation("Trying to load YAML file at: {path}", yamlFilePath);
                    var list = await gitService.ParseYAMLAsync(yamlFilePath);

                    //Print results
                    Logger.LogInformation("===========YAML FoldersToProcess===========");
                    foreach (string line in list)
                    {
                        Logger.LogInformation(line);
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading file.");
        }
    }

    private async Task SetWorkingDirectoryAsync()
    {
        try
        {
            var folder = await FolderPicker.PickAsync(default);

            if (folder.IsSuccessful && !string.IsNullOrEmpty(folder?.Folder?.Path))
            {
                Logger.LogInformation("Folder location: {path}", folder.Folder.Path);

                bool isGitRepo = await gitService.VerifyGitRepoAsync(folder.Folder.Path);

                if (!isGitRepo)
                {
                    Snackbar.Add("Not a Git Repo", Severity.Error);
                    return;
                }

                DeploymentOptions.WorkingDirectory = folder.Folder.Path;
                gitBranches = await gitService.GetBranchesAsync(folder.Folder.Path);

                Snackbar.Add("Directory Set Successfully", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading file.");
        }
    }

    private async Task RunGitDiffsAsync()
    {
        if (string.IsNullOrEmpty(DeploymentOptions.WorkingDirectory))
        {
            Snackbar.Add("Set Working Directory first", Severity.Warning);
            return;
        }

        var fileRelativePaths = await gitService.RunGitDiffsAsync(DeploymentOptions.WorkingDirectory, currentBranch, sourceBranch);
        DeploymentOptions.FileList = gitService.GetAbsolutFileList(DeploymentOptions.WorkingDirectory, fileRelativePaths);

        if (useYaml)
        {
            Logger.LogInformation("Trying to load YAML file at: {path}", yamlFilePath);
            yamlFilePath = Path.Combine(DeploymentOptions.WorkingDirectory, "azure-pipelines.yml");

            if (!File.Exists(yamlFilePath))
            {
                Logger.LogWarning("Could not find \"azure-pipelines.yml\" in current path");
            }
            else
            {
                Logger.LogInformation("Found YAML file at: {path}", yamlFilePath);
                yamlFoldersToProcess = await gitService.ParseYAMLAsync(yamlFilePath);
                Logger.LogInformation("Parsed YAML successfully");

                //Print results
                Logger.LogInformation("===========YAML FoldersToProcess===========");
                foreach (string line in yamlFoldersToProcess)
                {
                    Logger.LogInformation(line);
                }

                if (yamlFoldersToProcess is not null)
                {
                    Logger.LogInformation("Sorting according to YAML");
                    DeploymentOptions.FileList = gitService.SortByYaml(DeploymentOptions.WorkingDirectory, yamlFoldersToProcess, DeploymentOptions.FileList);
                }
            }
        }

        await DeploymentOptionsChanged.InvokeAsync(DeploymentOptions);

        // if (FileList.Count > 0)
        // {
        //     EnableRunSQLBtn(true);
        // }

        //Print results
        Logger.LogInformation("===========GIT Diffs dev-master===========");
        foreach (string line in DeploymentOptions.FileList)
        {
            Logger.LogInformation(line);
        }

        Snackbar.Add("Diffs Generated Successfully", Severity.Success);

    }
}
