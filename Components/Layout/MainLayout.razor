@using DevToolbox.Components.LogArea;
@using DevToolbox.Services;

@implements IDisposable
@inherits LayoutComponentBase

@inject TrayCommandService TrayCommandService
@inject NavigationManager NavigationManager

<div class="page">
    <div class="sidebar @(isCollapsed ? "collapsed" : "")">
        <NavMenu IsCollapsed="isCollapsed" IsCollapsedChanged="OnCollapsedChanged" />
    </div>

    <main>
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<MudThemeProvider Theme="_mudTheme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@code {
    private readonly MudTheme _mudTheme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#0F766E",
            Secondary = "#1D4ED8",
            Background = "#F4F7FA",
            Surface = "#FFFFFF",
            AppbarBackground = "#0F172A",
            AppbarText = "#E2E8F0"
        },
        LayoutProperties = new LayoutProperties
        {
            DefaultBorderRadius = "10px"
        }
    };

    private bool isCollapsed;

    protected override void OnInitialized()
    {
        isCollapsed = Preferences.Get("NavMenuCollapsed", false);
        TrayCommandService.KafkaDeserializeRequested += OnKafkaDeserializeRequested;
    }

    private void OnKafkaDeserializeRequested()
    {
        InvokeAsync(() => NavigationManager.NavigateTo("/kafkaserializer"));
    }

    private void OnCollapsedChanged(bool collapsed)
    {
        isCollapsed = collapsed;
        Preferences.Set("NavMenuCollapsed", collapsed);
    }

    public void Dispose()
    {
        TrayCommandService.KafkaDeserializeRequested -= OnKafkaDeserializeRequested;
    }
}