@using DevToolbox.Components.LogArea;

@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="split-container">
            <div class="content-section">
                <article class="content px-4">
                    @Body
                </article>
            </div>
            
            <div class="splitter" @onmousedown="@StartResize"></div>
            
            <div class="log-section" style="height: @(_logSectionHeight)px">
                <LogArea />
            </div>
        </div>

        <FluentToastProvider MaxToastCount="10" />
        <FluentMenuProvider />
    </main>
</div>

@code {
    private int _logSectionHeight = 200; // Default height
    private bool _isResizing = false;
    private int _lastY;

    private void StartResize(MouseEventArgs e)
    {
        _isResizing = true;
        _lastY = (int)e.ClientY;
        
        // Add event listeners for mouse move and up
        js.InvokeVoidAsync("window.addEventListener", "mousemove", DotNetObjectReference.Create(this));
        js.InvokeVoidAsync("window.addEventListener", "mouseup", DotNetObjectReference.Create(this));
    }

    [JSInvokable]
    public void OnMouseMove(MouseEventArgs e)
    {
        if (_isResizing)
        {
            var delta = (int)e.ClientY - _lastY;
            _logSectionHeight = Math.Max(100, Math.Min(800, _logSectionHeight - delta));
            _lastY = (int)e.ClientY;
            StateHasChanged();
        }
    }

    [JSInvokable]
    public void OnMouseUp()
    {
        _isResizing = false;
        
        // Remove event listeners
        js.InvokeVoidAsync("window.removeEventListener", "mousemove", DotNetObjectReference.Create(this));
        js.InvokeVoidAsync("window.removeEventListener", "mouseup", DotNetObjectReference.Create(this));
    }    [Inject]
    public required IJSRuntime js { get; set; }

    public void Dispose()
    {
        // Clean up event listeners if necessary
        if (_isResizing)
        {
            OnMouseUp();
        }
    }
}
