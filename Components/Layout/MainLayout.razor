@using DevToolbox.Components.LogArea;

@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <article class="content px-4">
            @Body
        </article>

        <section class="log-section" style="position: absolute; left: 0; right: 0; bottom: 0; height: 25vh; width: 100%; z-index: 10; margin-left: var(--sidebar-width, 250px);">
            <LogArea />
        </section>

        <FluentToastProvider MaxToastCount="10" />
    </main>
</div>
