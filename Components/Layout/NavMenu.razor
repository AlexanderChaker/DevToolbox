@using Microsoft.AspNetCore.Components.Web
@using Microsoft.FluentUI.AspNetCore.Components.DesignTokens

@inject AccentBaseColor AccentBaseColor

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Dev Toolbox</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="deploygitbranch" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span>
                Deploy SQL Branch
            </NavLink>
        </div>
    </nav>
    <div class="bottom-row">
        <FluentMenuButton @ref=menubutton Text="Settings" Items="@items" OnMenuChanged="HandleOnMenuChanged"></FluentMenuButton>
    </div>
</div>

@code {
    private FluentMenuButton menubutton = new();

    private Dictionary<string, string> items = new Dictionary<string, string>()
    {
        {"0078D4","Show Logs"}
    };

    private async Task HandleOnMenuChanged(MenuChangeEventArgs args)
    {
        await AccentBaseColor.SetValueFor(menubutton.Button!.Element, $"#{args.Id}".ToSwatch());
    }
}
