@using Microsoft.AspNetCore.Components.Web

<div class="navmenu @(IsCollapsed ? "collapsed" : "")">
    <div class="top-row ps-3 navbar navbar-dark">
        <div class="container-fluid">
            @if (!IsCollapsed)
            {
                <div class="brand-block">
                    <a class="navbar-brand" href="">Dev Toolbox</a>
                    <div class="navbar-version">@($"v{AppVersion}")</div>
                </div>
            }
        </div>
    </div>

    <input type="checkbox" title="Navigation menu" class="navbar-toggler" />

    <div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
        <nav class="flex-column">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="kafkaserializer" Match="NavLinkMatch.All">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span>
                    @if (!IsCollapsed)
                    {
                        <text>Kafka Serializer</text>
                    }
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="deploygitbranch" Match="NavLinkMatch.All">
                    <span class="bi bi-database-fill-nav-menu" aria-hidden="true"></span>
                    @if (!IsCollapsed)
                    {
                        <text>Deploy SQL Branch</text>
                    }
                </NavLink>
            </div>
        </nav>
    </div>

    <div class="bottom-row">
        <button class="collapse-toggle-btn" @onclick="ToggleCollapse" title="@(IsCollapsed ? "Expand menu" : "Collapse menu")">
            <span class="bi @(IsCollapsed ? "bi-chevron-right" : "bi-chevron-left")" aria-hidden="true"></span>
        </button>
    </div>
</div>

@code {
    [Parameter] public bool IsCollapsed { get; set; }
    [Parameter] public EventCallback<bool> IsCollapsedChanged { get; set; }

    private string AppVersion { get; } = DevToolbox.AppVersionInfo.Version;

    private async Task ToggleCollapse()
    {
        await IsCollapsedChanged.InvokeAsync(!IsCollapsed);
    }
}
