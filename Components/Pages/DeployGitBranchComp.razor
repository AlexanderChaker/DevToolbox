@using DevToolbox.Components.LogArea
@using Models;
@using DevToolbox.Components.DeployGitBranch;

@namespace DevToolbox.Components.Pages

@page "/deploygitbranch"

@inject ILogger<DeployGitBranchComp> Logger;

<div class="deploy-scroll-container">
    <MudStack Class="deploy-page" Spacing="2">
        <MudText Typo="Typo.h5">Deploy SQL Branch</MudText>
        <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4" Class="deploy-tabs">
            <MudTabPanel Text="Git">
                <GitManager @bind-DeploymentOptions=@deploymentOptions />
            </MudTabPanel>

            <MudTabPanel Text="Database">
                <SQLManager @bind-DeploymentOptions=@deploymentOptions />
            </MudTabPanel>

            <MudTabPanel Text="Deploy">
                <DeploymentManager @bind-DeploymentOptions=@deploymentOptions />
            </MudTabPanel>
        </MudTabs>
    </MudStack>

    <MudSwitch T="bool" @bind-Value="showConsole" @bind-Value:after="() => ShowConsoleAsync(showConsole)" Color="Color.Primary">
        Show Logs
    </MudSwitch>

    @if (showConsole)
    {
        <div class="deploy-bottom-row">
            <LogArea />
        </div>
    }
</div>

@code {
    protected DeploymentOptions deploymentOptions { get; set; } = new();
    protected Dictionary<string, object> pageGitMangagerHidden { get; set; } = new();
    protected Dictionary<string, object> pageSQLMangagerHidden { get; set; } = new();
    protected string? serverUrl { get; set; } //Return serverUrl from SQLManager and pass to DeploymentManager
    protected bool showConsole { get; set; }

    protected override async Task OnInitializedAsync()
    {
        showConsole = (await SecureStorage.Default.GetAsync("showConsole")) == "True";
    }

    private async Task ShowConsoleAsync(bool show)
    {
        await SecureStorage.Default.SetAsync("showConsole", show.ToString());
    }
}