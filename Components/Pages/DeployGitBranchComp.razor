@using CommunityToolkit.Maui.Storage;
@using Models;
@using DevToolbox.Components.DeployGitBranch;

@namespace DevToolbox.Components.Pages

@page "/deploygitbranch"

@inject ILogger<DeployGitBranchComp> Logger;

<FluentStack VerticalGap=15 Orientation=Orientation.Vertical VerticalAlignment=VerticalAlignment.Center>
    <FluentTabs>
        <FluentTab Id="tab-1" style="padding-top: 15px;">
            <Header>
                <FluentIcon Value="@(new Icons.Regular.Size24.CodeBlock())" />
                <span>Git</span>
            </Header>
            <Content>
                <GitManager @bind-DeploymentOptions=@deploymentOptions />
            </Content>
        </FluentTab>

        <FluentTab Id="tab-2" style="padding-top: 15px;">
            <Header>
                <FluentIcon Value="@(new Icons.Regular.Size24.Database())" />
                <span>Database</span>
            </Header>
            <Content>
                <SQLManager @bind-DeploymentOptions=@deploymentOptions />
            </Content>
        </FluentTab>

        <FluentTab Id="tab-3" style="padding-top: 15px;">
            <Header>
                <FluentIcon Value="@(new Icons.Regular.Size24.AddSquare())" />
                <span>Deploy</span>
            </Header>
            <Content>
                <DeploymentManager @bind-DeploymentOptions=@deploymentOptions />
            </Content>
        </FluentTab>
    </FluentTabs>

</FluentStack>

@code {

    protected DeploymentOptions deploymentOptions { get; set; } = new();
    protected Dictionary<string, object> pageGitMangagerHidden { get; set; } = new();
    protected Dictionary<string, object> pageSQLMangagerHidden { get; set; } = new();
    protected string? serverUrl { get; set; } //Return serverUrl from SQLManager and pass to DeploymentManager
    protected bool showConsole { get; set; }

    //CSS Styles
    const string consoleDefaultStyle = "font-size:small; font-family:Cascadia Code; line-height:normal;";
    const string constoleHiddenStyle = "display:none;";
    private Dictionary<string, object> consoleStyle { get; set; } = new Dictionary<string,object>{["style"] = consoleDefaultStyle};
    private Dictionary<string, object> clearLogsButtonStyle { get; set; } = new Dictionary<string,object>{["style"] = string.Empty};

    protected override async Task OnInitializedAsync()
    {
        showConsole = ((await SecureStorage.Default.GetAsync("showConsole")) == "True") ? true : false;
        await ShowConsoleAsync(showConsole);
    }

    private async Task ShowConsoleToggleAsync()
    {
        showConsole = !showConsole;
        await ShowConsoleAsync(showConsole);
    }

    private async Task ShowConsoleAsync(bool show)
    {
        if (show)
        {
            consoleStyle["style"] = consoleDefaultStyle;
            clearLogsButtonStyle["style"] = "visibility:visible;";
        }
        else
        {
            consoleStyle["style"] = constoleHiddenStyle;
            clearLogsButtonStyle["style"] = "visibility:hidden;";
        }

        await SecureStorage.Default.SetAsync("showConsole", show.ToString());
    }
}
