@using DevToolbox.Services.Interfaces
@using DevToolbox.Services

@namespace DevToolbox.Components.Pages

@page "/kafkaserializer"
@page "/"

@implements IDisposable

@inject IKafkaSerializerService KafkaSerializerService
@inject ISnackbar Snackbar
@inject TrayCommandService TrayCommandService

<MudStack Class="kafka-page" Spacing="2">

    <MudText Typo="Typo.h5">Kafka Serializer</MudText>

    <div class="kafka-actions">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => RunConvert())" StartIcon="@Icons.Material.Filled.PlayArrow">
            Convert
        </MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="@OnPasteFromClipboard" StartIcon="@Icons.Material.Filled.ContentPaste">
            Paste from Clipboard
        </MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="@OnClear" StartIcon="@Icons.Material.Filled.Delete">
            Clear
        </MudButton>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <MudAlert Severity="Severity.Error" Dense="true" Variant="Variant.Filled">@errorMessage</MudAlert>
    }

    <MudGrid Class="kafka-editors" Spacing="2">
        <MudItem xs="12" md="6" Class="kafka-editor-col">
            <MudText Typo="Typo.body2" Class="kafka-editor-title">Input JSON (compressed or uncompressed)</MudText>
            <MudTextField @bind-Value="inputJson"
                          Variant="Variant.Outlined"
                          FullWidth="true"
                          Lines="20"
                          AutoGrow="false"
                          Class="kafka-editor-input" />
        </MudItem>
        <MudItem xs="12" md="6" Class="kafka-editor-col">
            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Class="kafka-editor-title">
                <MudText Typo="Typo.body2">Output JSON</MudText>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" OnClick="@OnCopyOutput" Disabled="@(string.IsNullOrEmpty(outputJson))" StartIcon="@Icons.Material.Filled.ContentCopy">
                    Copy
                </MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" OnClick="@OnCopyEscaped" Disabled="@(string.IsNullOrEmpty(outputJson))" StartIcon="@Icons.Material.Filled.ContentCopy">
                    Copy Escaped
                </MudButton>
            </MudStack>
            <MudTextField @bind-Value="outputJson"
                          Variant="Variant.Outlined"
                          FullWidth="true"
                          Lines="20"
                          AutoGrow="false"
                          ReadOnly="true"
                          Class="kafka-editor-input" />
        </MudItem>
    </MudGrid>

</MudStack>

@code {
    private string? inputJson;
    private string? outputJson;
    private string? errorMessage;

    protected override void OnInitialized()
    {
        TrayCommandService.KafkaDeserializeRequested += OnTrayKafkaDeserialize;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && TrayCommandService.PendingKafkaDeserialize)
        {
            TrayCommandService.PendingKafkaDeserialize = false;
            await RunConvert(pasteFromClipboard: true);
            StateHasChanged();
        }
    }

    private void OnTrayKafkaDeserialize()
    {
        // If already on this page, handle directly
        TrayCommandService.PendingKafkaDeserialize = false;
        InvokeAsync(async () =>
        {
            await RunConvert(pasteFromClipboard: true);
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        TrayCommandService.KafkaDeserializeRequested -= OnTrayKafkaDeserialize;
    }

    private async Task OnPasteFromClipboard()
    {
        try
        {
            if (Clipboard.Default.HasText)
            {
                inputJson = await Clipboard.Default.GetTextAsync();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to read clipboard: {ex.Message}";
        }
    }

    private async Task RunConvert(bool pasteFromClipboard = false)
    {
        errorMessage = null;
        outputJson = null;

        try
        {
            if (pasteFromClipboard && Clipboard.Default.HasText)
            {
                inputJson = await Clipboard.Default.GetTextAsync();
            }

            if (string.IsNullOrWhiteSpace(inputJson))
            {
                errorMessage = pasteFromClipboard
                    ? "Clipboard is empty or does not contain text."
                    : "Please enter or paste JSON into the input area.";
                return;
            }

            outputJson = KafkaSerializerService.ProcessKafkaMessage(inputJson);
            await Clipboard.Default.SetTextAsync(outputJson);
            Snackbar.Add("Copied to Clipboard", Severity.Success);
        }
        catch (Exception ex)
        {
            errorMessage = $"Conversion failed: {ex.Message}";
        }
    }

    private async Task OnCopyOutput()
    {
        if (!string.IsNullOrEmpty(outputJson))
        {
            await Clipboard.Default.SetTextAsync(outputJson);
            Snackbar.Add("Copied to Clipboard", Severity.Success);
        }
    }

    private async Task OnCopyEscaped()
    {
        if (!string.IsNullOrEmpty(outputJson))
        {
            string? escaped = KafkaSerializerService.EscapeMessageProperty(outputJson);
            await Clipboard.Default.SetTextAsync(escaped);
            Snackbar.Add("Copied Escaped JSON to Clipboard", Severity.Success);
        }
    }

    private void OnClear()
    {
        inputJson = null;
        outputJson = null;
        errorMessage = null;
    }
}
