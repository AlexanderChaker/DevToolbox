@using DevToolbox.Services.Interfaces
@using DevToolbox.Services

@namespace DevToolbox.Components.Pages

@page "/kafkaserializer"
@page "/"

@implements IDisposable

@inject IKafkaSerializerService KafkaSerializerService
@inject ISnackbar Snackbar
@inject TrayCommandService TrayCommandService

<MudStack Spacing="2">

    <MudText Typo="Typo.h5">Kafka Serializer</MudText>

    <div>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => RunConvert())"
                   StartIcon="@Icons.Material.Filled.PlayArrow">
            Convert
        </MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="@OnPasteFromClipboard"
                   StartIcon="@Icons.Material.Filled.ContentPaste">
            Paste from Clipboard
        </MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="@OnClear"
                   StartIcon="@Icons.Material.Filled.Delete">
            Clear
        </MudButton>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <MudAlert Severity="Severity.Error" Dense="true" Variant="Variant.Filled">@errorMessage</MudAlert>
    }

    <MudGrid Spacing="6">
        <MudItem md="6">
            <MudText Typo="Typo.subtitle1" Class="kafka-editor-title">Input JSON (compressed or uncompressed)</MudText>
            <div Id="input-json-editor" class="json-editor-container">
                <StandaloneCodeEditor Id="input-json-editor" ConstructionOptions="InputEditorOptions" />
            </div>
        </MudItem>
        <MudItem md="6">
            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Class="kafka-editor-title">
                <MudText Typo="Typo.subtitle1">Output JSON</MudText>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" OnClick="@OnCopyOutput"
                           Disabled="@(string.IsNullOrEmpty(outputJson))" StartIcon="@Icons.Material.Filled.ContentCopy">
                    Copy
                </MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" OnClick="@OnCopyEscaped"
                           Disabled="@(string.IsNullOrEmpty(outputJson))" StartIcon="@Icons.Material.Filled.ContentCopy">
                    Copy Escaped
                </MudButton>
            </MudStack>
            <div Id="output-json-editor" class="json-editor-container">
                <StandaloneCodeEditor Id="output-json-editor" ConstructionOptions="OutputEditorOptions" />
            </div>
        </MudItem>
    </MudGrid>

</MudStack>

@code {
    private string? inputJson;
    private string? outputJson;
    private string? errorMessage;

    protected override void OnInitialized()
    {
        TrayCommandService.KafkaDeserializeRequested += OnTrayKafkaDeserialize;

        //Testing
        inputJson = @"
[
    {
        ""name"": ""Adeel Solangi"",
        ""language"": ""Sindhi"",
        ""id"": ""V59OF92YF627HFY0"",
        ""bio"": ""Donec lobortis eleifend condimentum. Cras dictum dolor lacinia lectus vehicula rutrum. Maecenas quis nisi nunc. Nam tristique feugiat est vitae mollis. Maecenas quis nisi nunc."",
        ""version"": 6.1
    },
    {
        ""name"": ""Afzal Ghaffar"",
        ""language"": ""Sindhi"",
        ""id"": ""ENTOCR13RSCLZ6KU"",
        ""bio"": ""Aliquam sollicitudin ante ligula, eget malesuada nibh efficitur et. Pellentesque massa sem, scelerisque sit amet odio id, cursus tempor urna. Etiam congue dignissim volutpat. Vestibulum pharetra libero et velit gravida euismod."",
        ""version"": 1.88
    },
    {
        ""name"": ""Aamir Solangi"",
        ""language"": ""Sindhi"",
        ""id"": ""IAKPO3R4761JDRVG"",
        ""bio"": ""Vestibulum pharetra libero et velit gravida euismod. Quisque mauris ligula, efficitur porttitor sodales ac, lacinia non ex. Fusce eu ultrices elit, vel posuere neque."",
        ""version"": 7.27
