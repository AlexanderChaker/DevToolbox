@using CommunityToolkit.Maui.Storage;
@using Services;

@inject ILogger<DeploymentManager> Logger;
@inject ISQLService sqlService;
@inject IToastService ToastService;

<FluentStack Orientation=Orientation.Vertical Width="100%">

    <div style="width:auto;min-width:500px">
    <FluentListbox TOption="string"
                   Items="@FileList"
                   Id="fileListbox"
                   Height="300px"
                   Width="100%"
                   OptionValue="@(f=>FileList?.IndexOf(f).ToString())"
                   OptionText="@(f=>f)"
                   @bind-Value="@SelectedValue"
                   @bind-SelectedOption="@SelectedItem" />
    </div>

    <FluentMenu Anchor="fileListbox" Trigger="MouseButton.Right" Anchored="false" @onmenuchange=OnMenuChange >
        <FluentMenuItem Label="Item 1" />

        <FluentMenuItem Label="Item 2">
            <MenuItems>
                <FluentMenuItem Label="Item 2.1">
                    <MenuItems>
                        <FluentMenuItem Label="Item 2.1.1" />
                        <FluentMenuItem Label="Item 2.1.2" />
                    </MenuItems>
                </FluentMenuItem>
                <FluentMenuItem Label="Item 2.2" />
            </MenuItems>
        </FluentMenuItem>

        <FluentMenuItem Label="Item 3" />
    </FluentMenu>

    @* <p>@status</p> *@

    @* <div>
        @("Selected Value: " + SelectedValue) <br />
        @("Selected Item: " + SelectedItem) <br />
    </div> *@

    <div>
        <label> @processedQueries </label>
        <label> out of </label>
        <label> @(FileList?.Count ?? 0) </label>
    </div>

    <FluentCounterBadge Count=@(FileList?.Count??0) Appearance=Appearance.Lightweight BottomPosition=70 HorizontalPosition=70 ShowZero=true>
        <FluentButton Appearance="Appearance.Accent" @onclick="RunSQLQueries" AdditionalAttributes=btnRunSQLEnabled>Run SQL</FluentButton>
    </FluentCounterBadge>


</FluentStack>

@code {
    [Parameter]
    public EventCallback<List<string>?> FileListChanged { get; set; }

    [Parameter]
    public List<string>? FileList { get; set; }

    [Parameter]
    public string? ServerUrl { get; set; }

    [Parameter]
    public string Logs { get; set; } = "";

    [Parameter]
    public EventCallback<string> LogsChanged { get; set; }

    private decimal processedQueries = 0;
    private decimal totalQueries = 0;
    protected Dictionary<string, object>? btnRunSQLEnabled { get; set; } // https://learn.microsoft.com/en-us/aspnet/core/blazor/components/splat-attributes-and-arbitrary-parameters?view=aspnetcore-8.0

    private string SelectedValue { get; set; } = "";
    private string SelectedItem { get; set; } = "";

    private static string _id = "progressToast";
    private CancellationTokenSource _cancel = new();
    private ToastParameters<ProgressToastContent> _progressToastData = new()
        {
            Id = _id,
            Intent = ToastIntent.Progress,
            Title = "Running SQL Queries",
            Timeout = 0,
            TopAction = "Cancel",

            OnTopAction = EventCallback.Factory.Create<ToastResult>(_id/*this*/, ClickedCancel),
            Content = new ProgressToastContent()
            {
                Details = "This may take a while.",
                Progress = 0
            }
        };

    private static void ClickedCancel()
    {
        //DemoLogger.WriteLine($"Clicked cancel");
    }

    private void ResetProgressToast()
    {
        _cancel.Cancel();
        _progressToastData.Content.Progress = 0;
        ToastService.UpdateToast(_id, _progressToastData);
        _cancel = new();
        //EnableRunSQLBtn(false);
    }

    private async Task RunSQLQueries()
    {
        //Reset
        Logs = string.Empty;
        processedQueries = 0;
        totalQueries = FileList?.Count??0;
        ToastService.CloseToast(_id);

        if (FileList is null)
        {
            // throw new Exception("File List needs to be generated");
            ToastService.ShowWarning("Generate Diffs first");
            return;
        }

        if (ServerUrl is null)
        {
            //throw new Exception("Server URL needs to be set");
            ToastService.ShowWarning("Set Server URL first");
            return;
        }

        Logger.LogInformation("===========Query Results===========");

        try
        {
            ToastService.ShowProgressToast(_progressToastData);

            foreach (string file in FileList)
            {
                var results = await sqlService.RunSQLQueryAsync(ServerUrl, file);

                //Update Toast Progress
                processedQueries++;
                _progressToastData.Content.Progress = (int)((processedQueries/totalQueries)*100);
                ToastService.UpdateToast(_id, _progressToastData);

                //Print results
                foreach (string result in results)
                {
                    Logger.LogInformation(result);
                    Logs += $"[{DateTime.Now}] {result}\n";
                    await LogsChanged.InvokeAsync(Logs);
                }

                await Task.Delay(100, _cancel.Token);
            }
            
            ToastService.ShowSuccess("SQL Queries Deployed Successfully");
        }
        catch (Exception)
        {
            ToastService.ShowError("Could not run all SQL queries");
        }
    }

    private void EnableRunSQLBtn(bool enable)
    {
        btnRunSQLEnabled = btnRunSQLEnabled ?? new Dictionary<string, object>();

        if (enable)
        {
            btnRunSQLEnabled?.Clear();
        }
        else
        {
            btnRunSQLEnabled["disabled"] = "";
        }
    }

    private string status = "";

    private void OnMenuChange(MenuChangeEventArgs args)
    {
        if (args is not null && args.Value is not null)
            status = $"Item \"{args.Value}\" clicked";
    }
}
