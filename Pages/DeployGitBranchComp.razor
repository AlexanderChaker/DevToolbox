@page "/deploygitbranch"

@using Microsoft.Extensions.Logging;

@inject ILogger<DeployGitBranchComp> Logger;

<div style="border:thin;border-style:solid;margin-top:20px;margin-bottom:20px;padding:20px" @attributes=pageGitMangagerHidden>
    <GitManager @bind-FileList=fileList />
</div>

<div style="border:thin;border-style:solid;margin-top:20px;margin-bottom:20px;padding:20px" @attributes=pageSQLMangagerHidden>
    <SQLManager FileList=fileList/>
</div>

<div>
    <button button class="btn btn-primary" @onclick="()=>PageSelect(2)" >Next</button><br />
</div>

<div>
    <h4>Console</h4>
    <InputTextArea type="text" style="width:50%; height:500px; font-size:12px;" @bind-Value=@console readonly="true"></InputTextArea> <br />
</div>

@code {

    protected string console { get; set; } = "";
    protected List<string>? fileList { get; set; } //Return FileList from GitManager and pass to SQLManager
    protected Dictionary<string, object> pageGitMangagerHidden { get; set; } = new();
    protected Dictionary<string, object> pageSQLMangagerHidden { get; set; } = new();

    void PageSelect(int page)
    {
        switch (page)
        {
            case 1:
                pageGitMangagerHidden.Clear();
                pageSQLMangagerHidden["hidden"] = "";
                break;
            case 2:
                pageGitMangagerHidden["hidden"] = "";
                pageSQLMangagerHidden.Clear();
                break;
            default:
                pageGitMangagerHidden.Clear();
                pageSQLMangagerHidden["hidden"] = "";
                break;
        };
    }

    protected override void OnInitialized()
    {
        PageSelect(1);
    }
}
