@page "/deploygitbranch"

@using Microsoft.Extensions.Logging;
@using Microsoft.Fast.Components.FluentUI;

@inject ILogger<DeployGitBranchComp> Logger;

<FluentTabs @bind-ActiveTabId="@activeId" OnTabChange="HandleOnTabChange">
    <FluentTab Label="Git" Id="tab-1" LabelStyle="font-size:25px;">
        <GitManager @bind-FileList=fileList />
    </FluentTab>

    <FluentTab Label="Database" Id="tab-2" LabelStyle="font-size:25px;">
        <SQLManager FileList=fileList @bind-ServerUrl=serverUrl/>
    </FluentTab>

    <FluentTab Label="Deploy" Id="tab-3" LabelStyle="font-size:25px;">
        <DeploymentManager @bind-FileList=fileList @bind-Logs=console ServerUrl=@serverUrl />
    </FluentTab>
</FluentTabs>
<br/>
<div>
    <button button class="btn btn-primary" @onclick=PreviousTab>Previous</button>
    <button button class="btn btn-primary" @onclick=NextTab>Next</button><br />
</div>

<div>
    <h4>Console</h4>
    <InputTextArea type="text" style="width:70%; height:500px; font-size:12px;" @bind-Value=console readonly="true"></InputTextArea> <br />
</div>

@code {

    protected string console { get; set; } = "";
    protected List<string>? fileList { get; set; } //Return FileList from GitManager and pass to SQLManager
    protected Dictionary<string, object> pageGitMangagerHidden { get; set; } = new();
    protected Dictionary<string, object> pageSQLMangagerHidden { get; set; } = new();
    protected string activeId = "";
    protected FluentTab? changedTo;
    protected string? serverUrl { get; set; } //Return serverUrl from SQLManager and pass to DeploymentManager

    protected List<string> Tabs { get; set; } = new()
    {
        {"tab-1"},
        {"tab-2"},
        {"tab-3"}
    };

    private void HandleOnTabChange(FluentTab tab)
    {
        changedTo = tab;
    }

    void PreviousTab()
    {
        var currentIndex = Tabs.IndexOf(activeId);
        if (currentIndex - 1 < 0)
        {
            return;
        }

        activeId = Tabs[currentIndex - 1];
    }

    void NextTab()
    {
        var currentIndex = Tabs.IndexOf(activeId);
        if ((currentIndex < 0) || currentIndex + 1 >= Tabs.Count)
        {
            return;
        }

        activeId = Tabs[currentIndex + 1];
    }

    protected override void OnInitialized()
    {
        activeId = "tab-1";
    }
}
