@using CommunityToolkit.Maui.Storage;
@using DeployGitBranch.Models
@page "/"

@inject ILogger<DeployGitBranchComp> Logger;

<FluentStack VerticalGap=15 Orientation=Orientation.Vertical VerticalAlignment=VerticalAlignment.Center>
    <FluentTabs @bind-ActiveTabId="@activeId" OnTabChange="HandleOnTabChange">
        <FluentTab Id="tab-1">
            <Header>
                <FluentIcon Value="@(new Icons.Regular.Size24.CodeBlock())" />
                <span style="font-size:25px;">Git</span>
            </Header>
            <Content>
                <GitManager @bind-DeploymentOptions=@deploymentOptions />
            </Content>
        </FluentTab>

        <FluentTab Id="tab-2">
            <Header>
                <FluentIcon Value="@(new Icons.Regular.Size24.Database())" />
                <span style="font-size:25px;">Database</span>
            </Header>
            <Content>
                <SQLManager @bind-DeploymentOptions=@deploymentOptions />
            </Content>
        </FluentTab>

        <FluentTab Id="tab-3">
            <Header>
                <FluentIcon Value="@(new Icons.Regular.Size24.AddSquare())" />
                <span style="font-size:25px;">Deploy</span>
            </Header>
            <Content>
                <DeploymentManager @bind-DeploymentOptions=@deploymentOptions />
            </Content>
        </FluentTab>
    </FluentTabs>

    <FluentStack Orientation=Orientation.Horizontal VerticalAlignment=VerticalAlignment.Center>
        <FluentSwitch id="showConsoleSwitch" Label="Show Console" Value=showConsole ValueChanged=ShowConsoleToggleAsync />
        <FluentButton Title="Clear Logs" Appearance="Appearance.Stealth" IconEnd="@(new Icons.Regular.Size16.Delete())" AdditionalAttributes=hideConsoleAttribute OnClick=@(()=>ClearLogs()) />
    </FluentStack>

    <div @attributes=hideConsoleAttribute>
        <FluentTextArea Appearance=FluentInputAppearance.Outline Cols=120 Rows=10 Resize="TextAreaResize.Vertical" ReadOnly=true @bind-Value=@deploymentOptions.Logs AdditionalAttributes=@(new Dictionary<string,object>{["style"]="font-size:small; font-family:math; line-height:normal;"})></FluentTextArea>
    </div>
</FluentStack>

@code {

    protected DeploymentOptions deploymentOptions { get; set; } = new();
    protected Dictionary<string, object> pageGitMangagerHidden { get; set; } = new();
    protected Dictionary<string, object> pageSQLMangagerHidden { get; set; } = new();
    protected string activeId = "";
    protected FluentTab? changedTo;
    protected string? serverUrl { get; set; } //Return serverUrl from SQLManager and pass to DeploymentManager
    protected Dictionary<string, object>? hideConsoleAttribute { get; set; }
    protected bool showConsole { get; set; }

    private void HandleOnTabChange(FluentTab tab)
    {
        changedTo = tab;
    }

    protected override async Task OnInitializedAsync()
    {
        showConsole = ((await SecureStorage.Default.GetAsync("showConsole")) == "True") ? true : false;
        await ShowConsoleAsync(showConsole);

        activeId = "tab-1";
    }

    private async Task ShowConsoleToggleAsync()
    {
        showConsole = !showConsole;
        await ShowConsoleAsync(showConsole);
    }

    private async Task ShowConsoleAsync(bool show)
    {
        hideConsoleAttribute = hideConsoleAttribute ?? new Dictionary<string, object>();

        if (show)
        {
            hideConsoleAttribute?.Clear();
        }
        else
        {
            hideConsoleAttribute["style"] = "visibility:hidden";
        }

        await SecureStorage.Default.SetAsync("showConsole", show.ToString());
    }

    private void ClearLogs()
    {
        deploymentOptions.Logs = string.Empty;
    }
}
