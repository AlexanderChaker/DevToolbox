@using CommunityToolkit.Maui.Storage;
@using DeployGitBranch.Models
@using Services;

@inject ILogger<SQLManager> Logger;
@inject ISQLService sqlService;
@inject IToastService ToastService;

<FluentStack Orientation=Orientation.Vertical VerticalAlignment="VerticalAlignment.Center">
    <FluentStack Orientation=Orientation.Horizontal>
        <FluentTextField @bind-Value=@serverUrl Size="60" />
        <FluentButton Appearance="Appearance.Accent" @onclick="SetServerURL">Set Server</FluentButton>
    </FluentStack>

    <FluentStack Orientation=Orientation.Horizontal VerticalAlignment=VerticalAlignment.Center>
        <FluentCombobox Label="Default DB (optional)" Autocomplete="ComboboxAutocomplete.Both" Items="dbNames" @bind-Value="@dbName" Height="200px" Width="200px" />
    </FluentStack>
</FluentStack>

@code {
    [Parameter]
    public DeploymentOptions DeploymentOptions { get; set; } = new();

    [Parameter]
    public EventCallback<DeploymentOptions> DeploymentOptionsChanged { get; set; }

    protected string dbName { get; set; } = "";
    protected List<string> dbNames { get; set; } = new();
    protected string serverUrl { get; set; } = "";

    protected override async Task OnInitializedAsync()
    {
        serverUrl = await SecureStorage.Default.GetAsync("serverUrl")??"";
    }

    private async Task SetServerURL()
    {
        //TODO check if the connection is valid
        string connectionString = $"Server={serverUrl};Integrated Security=true;Multisubnetfailover=yes;Application Name=DevToolkit.DeployGitBranch;Encrypt=false";
        sqlService.SetConnectionString(connectionString);

        try
        {
            dbNames = await sqlService.GetDBListAsync();
        }
        catch (Exception)
        {
            ToastService.ShowError("Failed To Set Server");
            return;
        }
        
        DeploymentOptions.ServerUrl = serverUrl;
        await SecureStorage.Default.SetAsync("serverUrl", serverUrl);
        await DeploymentOptionsChanged.InvokeAsync(DeploymentOptions);

        ToastService.ShowSuccess("Server Set Successfully");
    }

}
