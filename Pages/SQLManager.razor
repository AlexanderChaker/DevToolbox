@using CommunityToolkit.Maui.Storage;
@using Services;
@using Microsoft.Extensions.Logging;

@inject ILogger<SQLManager> Logger;
@inject ISQLService sqlService;

<div>
    <InputText id="serverUrl" type="text" style="width:500px" @bind-Value=@serverUrl> </InputText>
    <button class="btn btn-primary" @onclick="SetServerURL">Set Server</button> <br />

    <table>
        <tr>
            <td><label> Default DB </label> </td>
            <td>
                <InputSelect id="dbName" style="width:100px" @bind-Value=@dbName>
                    @foreach (string name in dbNames)
                    {
                        <option value=@name>@name</option>
                    }
                </InputSelect> <br />
            </td>
        </tr>
    </table>
</div>

@code {
    [Parameter]
    public List<string>? FileList { get; set; }

    [Parameter]
    public string? ServerUrl { get; set; }

    [Parameter]
    public EventCallback<string> ServerUrlChanged { get; set; }

    protected string dbName { get; set; } = "";
    protected List<string> dbNames { get; set; } = new();
    protected string serverUrl { get; set; } = "";

    protected override async Task OnInitializedAsync()
    {
        serverUrl = await SecureStorage.Default.GetAsync("serverUrl")??"";
    }

    private async Task SetServerURL()
    {
        //TODO check if the connection is valid
        string connectionString = $"Server={serverUrl};Integrated Security=true;Multisubnetfailover=yes;Application Name=DevToolkit.DeployGitBranch;Encrypt=false";
        sqlService.SetConnectionString(connectionString);

        dbNames = await sqlService.GetDBListAsync();
        
        ServerUrl = serverUrl;
        await SecureStorage.Default.SetAsync("serverUrl", serverUrl);
        await ServerUrlChanged.InvokeAsync(ServerUrl);
    }

}
